{
  "name": "conscientious",
  "version": "1.5.0",
  "description": "Tools that nudge Claude to be more conscientious. Features: /clarify (thorough clarifying questions in plan mode), /biblio (reference or ignore repo docs in plan mode), /taciturn (keep code comments minimal and terse), /fastidious (plan, implement, and verify exhaustively), /synoptic (one-line birds-eye commit messages), /remind-me (per-project saved tasks with menu recall + optional auto-propose). Always-on directives (no toggle, not in the statusline): drift-resistant comments and documentation, and sycophancy-resistant response tone.",
  "author": {
    "name": "Benjamin Gearig",
    "url": "https://github.com/bengearig"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/clarify-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading clarify..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/biblio-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading biblio..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/taciturn-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading taciturn..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fastidious-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading fastidious..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/synoptic-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading synoptic..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/remind-me-propose-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading remind-me..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/conscientious-statusline-nudge.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/clarify-mode-tracker.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/biblio-mode-tracker.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/taciturn-mode-tracker.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fastidious-mode-tracker.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/synoptic-mode-tracker.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/remind-me-propose-mode-tracker.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/remind-me-mode-context.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/conscientious-reinforce.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
